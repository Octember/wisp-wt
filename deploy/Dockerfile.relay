# Build from repo root:
#   docker build -f deploy/Dockerfile.relay -t wisp-wt-relay .
#
# Required runtime env vars (or CLI flags):
#   WISP_CERT=/path/to/fullchain.pem
#   WISP_KEY=/path/to/privkey.pem
#   WISP_ALLOW_ORIGINS=https://app.example.com
FROM rust:1.91-bookworm AS builder
WORKDIR /app
COPY relay/Cargo.toml relay/Cargo.lock* ./
COPY relay/src ./src
RUN cargo build --release --bin wisp-wt-relay

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/wisp-wt-relay /usr/local/bin/wisp-wt-relay

EXPOSE 443/udp 443/tcp
ENTRYPOINT ["/usr/local/bin/wisp-wt-relay"]
CMD ["--wt-bind", "0.0.0.0:443", "--ws-bind", "0.0.0.0:443", "--ws-tls"]
