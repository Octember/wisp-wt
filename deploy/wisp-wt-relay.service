[Unit]
Description=Wisp-WT Dual-Stack WebTransport + WebSocket Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wisp
Group=wisp
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/wisp-wt-relay \
  --wt-bind 0.0.0.0:443 \
  --ws-bind 0.0.0.0:443 \
  --ws-tls \
  --cert /etc/letsencrypt/live/relay.example.com/fullchain.pem \
  --key /etc/letsencrypt/live/relay.example.com/privkey.pem \
  --allow-origin https://unkernel.dev \
  --allow-origin https://trynix.dev \
  --auth-token ${WISP_AUTH_TOKEN} \
  --max-sessions-per-ip 16 \
  --max-streams-per-session 256
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
