{
  "name": "wisp-wt",
  "version": "0.1.1",
  "description": "WebTransport (HTTP/3) transport binding for Wisp with automatic WebSocket fallback, dual-stack Rust relay, and unkernel NetBackend adapter.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./unkernel": {
      "types": "./dist/unkernel.d.ts",
      "default": "./dist/unkernel.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SPEC.md"
  ],
  "sideEffects": false,
  "keywords": [
    "wisp",
    "webtransport",
    "http3",
    "quic",
    "websocket",
    "unkernel",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octember/wisp-wt.git"
  },
  "homepage": "https://github.com/Octember/wisp-wt#readme",
  "bugs": {
    "url": "https://github.com/Octember/wisp-wt/issues"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "relay": "cargo run --manifest-path relay/Cargo.toml -- --dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun test && (cd relay && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test)",
    "prepublishOnly": "bun run typecheck && bun run build && bun test",
    "demo": "bun demo/server.ts",
    "verify:unkernel": "bun scripts/verify-unkernel.ts"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "typescript": "^5.8.0",
    "unkernel": "^0.2.0-261124-c08e977"
  }
}
